# Bloc à AJOUTER dans ton Caddyfile existant (ne pas remplacer tout le fichier).
# Sert le rapport PEA sur un sous-domaine dédié. Caddy route par le Host, donc
# ce bloc cohabite avec tes autres sites sur :80.
#
# Cloudflare Tunnel gère le TLS au bord → Caddy reste en HTTP simple.
# Fais pointer le hostname public "pea.tondomaine.fr" du tunnel sur http://127.0.0.1:80
#
# Accès LAN direct :  http://<IP_DU_LXC>/   (le bloc :80 par défaut, si présent)
# Accès externe :     https://pea.tondomaine.fr/  (via Cloudflare)

pea.tondomaine.fr {
	root * /var/www/pea
	file_server
	encode gzip

	# --- Optionnel : restreindre l'accès (sinon utilise Cloudflare Access) ---
	# basic_auth {
	#     jp <HASH_BCRYPT>   # génère avec: caddy hash-password
	# }

	log {
		output file /var/log/caddy/pea.log
	}
}
